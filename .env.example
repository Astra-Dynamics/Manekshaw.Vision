# Manekshaw.Vision Environment Variables
# Copy to .env.local for local development. Never commit real keys to git.

# Supabase Public Keys (Client & Serverless)
VITE_SUPABASE_URL=https://fahbbsdgurtwmfjhtxkh.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Supabase Service Role Key (Backend Server & GitHub Actions Ingest ONLY)
# Never expose to the browser or commit to git
